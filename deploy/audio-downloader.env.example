# Copy to a protected host-only file. Do not commit filled copy.
# sudo install -m 600 -o root -g audio-downloader deploy/audio-downloader.env.example /etc/audio-downloader/audio-downloader.env

# Local, non-Dropbox state and staging
AUDIO_STAGING_ROOT=/var/lib/audio-downloader/staging
AUDIO_STATE_DB=/var/lib/audio-downloader/state.db
# Point this at Dropbox directory owned by audio-downloader.
AUDIO_OUTPUT_ROOT=/var/lib/audio-downloader/dropbox
AUDIO_DROPBOX_HEALTH_COMMAND=pgrep -u audio-downloader dropbox
AUDIO_FFPROBE_COMMAND=ffprobe
AUDIO_FFMPEG_COMMAND=ffmpeg
AUDIO_TIMEZONE=America/Los_Angeles

# SMTP. Fill all five values or leave all unset.
# AUDIO_SMTP_HOST=smtp.gmail.com
# AUDIO_SMTP_PORT=587
# AUDIO_SMTP_USERNAME=
# AUDIO_SMTP_PASSWORD=
# AUDIO_ALERT_FROM=
# AUDIO_ALERT_TO=

# TTWN NBC. Required by nbc-poll.
# AUDIO_NBC_URL=              # API base URL, not the /newFiles suffix
# AUDIO_NBC_AFFILIATE=News-247
# AUDIO_NBC_API_KEY=

# Source definitions are one JSON object in protected env. Each source declares transport,
# endpoint/host, credentials, expected output contracts, and validation thresholds.
# Add only after a live provider probe; absent definitions report `unverified`, never success.
# AUDIO_SOURCE_DEFINITIONS={...}
# Never add values to this example, systemd units, logs, fixtures, or Markdown.
